{
  "manifest_version": 3,
  "name": "Bobdoc",
  "version": "3.0.0",
  "description": "Tired of copy-pasting articles with broken formatting? One click exports any webpage to a clean, properly formatted DOCX or PDF.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "commands": {
    "export-docx": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Export page as DOCX"
    },
    "export-pdf": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Export page as PDF"
    }
  },
  "host_permissions": [
    "https://bobdoc.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "libs/Readability.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
